  {
    "event_id": "JN_EVT_006",
    "event_name": "EVT_book_field",
    "event_description": "会员订场并支付，生成订场订单全链路",
    "system": "jianengliang",
    "phase": "batch5",
    "trigger": {
      "order_type": ["2"],
      "conditions": ["member_exists", "venue_exists", "sport_exists"],
      "probability_keys": ["complete_payment", "use_coupon", "use_time_card", "add_ticket_people", "accumulate_points"]
    },
    "table_actions": [
      {
        "table": "ods_wenti_j_member_order",
        "action": "insert",
        "rows": 1,
        "row_rule": "one_per_event",
        "condition": null,
        "required": true
      },
      {
        "table": "ods_wenti_j_order_field",
        "action": "insert",
        "rows": "field_slot_count",
        "row_rule": "one_per_field_slot",
        "condition": null,
        "required": true,
        "notes": "通常1条，多时段预约可多条，均共享同一 order_num"
      },
      {
        "table": "ods_wenti_j_order_coupon",
        "action": "insert",
        "rows": 1,
        "row_rule": "one_per_event",
        "condition": "use_coupon=true AND coupon_available=true",
        "required": false
      },
      {
        "table": "ods_wenti_j_order_card_expense",
        "action": "insert",
        "rows": 1,
        "row_rule": "one_per_event",
        "condition": "use_time_card=true AND time_card_available=true",
        "required": false
      },
      {
        "table": "ods_wenti_j_time_card_use",
        "action": "insert",
        "rows": 1,
        "row_rule": "one_per_event",
        "condition": "use_time_card=true AND time_card_available=true",
        "required": false,
        "notes": "DEC-P2-05已决策：与 j_order_card_expense 同批次写入，order_num一致"
      },
      {
        "table": "ods_wenti_j_order_btp",
        "action": "insert",
        "rows": "ticket_people_count",
        "row_rule": "one_per_ticket_person",
        "condition": "add_ticket_people=true AND ticket_people_exist=true",
        "required": false
      },
      {
        "table": "ods_wenti_j_points_records",
        "action": "insert",
        "rows": 1,
        "row_rule": "one_per_event",
        "condition": "complete_payment=true AND accumulate_points=true",
        "required": false,
        "notes": "DEC-P2-03已决策：条件由编排器判断，target_tables中按条件包含/排除"
      }
    ],
    "state_updates": [
      {
        "table": "ods_wenti_j_coupon",
        "condition": "use_coupon=true",
        "idempotent_key": "coupon_id",
        "fields": {"status": 2, "use_time": "order_time", "use_type": 2},
        "notes": "use_type=2（订场）"
      }
    ],
    "shared_keys": ["member_id", "phone", "venue_id", "order_num", "coupon_id", "time_card_record_id"],
    "key_generation": {
      "order_id": "auto_increment_start_50001",
      "order_num": "JN+yyyyMMddHHmmss+3位序号"
    },
    "preconditions": ["member_exists", "venue_exists", "sport_exists"],
    "postconditions": [
      "j_order_field.order_num == j_member_order.order_num",
      "pay_amount = cost - discount_amount - deducted_amount",
      "is_pay=1 时 pay_time > create_time",
      "is_pay=0 时 pay_time=NULL",
      "use_coupon=true 时 j_order_coupon 存在且 j_coupon.status=2"
    ],
    "follow_up_events": [],
    "phase1_scope": "in_scope",
    "notes": "j_member_order_detail 不适用于订场（DEC-P2-04：只有游泳票）。j_member_order.venue_id 为 INT 类型（DDL确认）。"
  },

